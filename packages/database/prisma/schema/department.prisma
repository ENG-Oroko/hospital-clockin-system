// Location: packages/database/prisma/schema/department.prisma

model Department {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String   @db.VarChar(100)
  code            String   @db.VarChar(20)
  parentId        String?  @map("parent_id") @db.Uuid
  costCenterCode  String?  @map("cost_center_code") @db.VarChar(50)
  status          String   @default("ACTIVE") @db.VarChar(30)
  rules           Json     @default("{}") @map("rules") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  
  parent          Department?  @relation("parent_children", fields: [parentId], references: [id])
  children        Department[] @relation("parent_children")
  
  users           User[]
  rosterAssignments RosterAssignment[]
  departmentAudits DepartmentAudit[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([parentId])
  @@map("departments")
}

model DepartmentAudit {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(50)
  previousValue Json?   @map("previous_value") @db.JsonB
  newValue     Json?    @map("new_value") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  actor      User?      @relation("DepartmentAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, departmentId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("department_audits")
}
