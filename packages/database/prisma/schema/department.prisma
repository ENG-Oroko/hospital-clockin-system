// Location: packages/database/prisma/schema/department.prisma

model Department {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String   @db.VarChar(100)
  code            String   @db.VarChar(20)
  parentId        String?  @map("parent_id") @db.Uuid
  costCenterCode  String?  @map("cost_center_code") @db.VarChar(50)
  rules           Json     @default("{}") @map("rules") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  
  parent          Department?  @relation("parent_children", fields: [parentId], references: [id])
  children        Department[] @relation("parent_children")
  
  users           User[]
  rosterAssignments RosterAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
  @@map("departments")
}